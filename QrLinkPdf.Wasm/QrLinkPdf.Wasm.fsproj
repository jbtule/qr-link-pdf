<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The browser TFM is what makes NuGet pick PDFtoImage's
         lib/net10.0-browser1.0 assets and its browser dependency group (the
         PDFium Emscripten archive). A plain net10.0 app would silently get the
         desktop build, which P/Invokes a pdfium shared library that doesn't
         exist in a browser. -->
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <RootNamespace>QrLinkPdf.Wasm</RootNamespace>
    <AssemblyName>QrLinkPdf.Wasm</AssemblyName>

    <!-- PDFium and Skia ship as Emscripten static archives that have to be
         linked into dotnet.wasm. Forced on so plain `dotnet build` relinks too,
         not just `publish` - otherwise dev runs get a runtime with no PDFium in
         it and fail with EntryPointNotFoundException. -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- PDFium is not thread-safe, and this also selects SkiaSharp's
         single-threaded archive variant. -->
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <!-- PDFium resolves libjpeg from libSkiaSharp.a rather than bundling its
         own. PDFtoImage sets this in buildTransitive, but only under a
         net9.0-browser1.0 folder, so set it here explicitly. -->
    <PDFiumUseSystemLibjpeg>true</PDFiumUseSystemLibjpeg>

    <!-- Deliberately off, and it has been tried: AOT builds and runs fine
         here - iText's reflective BouncyCastle lookup, F# printf and Bolero's
         component activation all survive it, so this is a size decision, not
         a compatibility one.

         Measured on a 7-code handout: AOT scans in 1.4s against 2.5s
         interpreted, but grows the bundle from 27 MB to 67 MB, nearly all of
         it dotnet.native.wasm going 8.5 MB -> 48 MB. Most of the wall time is
         PDFium rasterizing, which is already native and gains nothing, so
         only ZXing's managed decode loop speeds up. Trading a much slower
         first load for ~1s is a poor deal for a tool someone uses once.

         Note trimming is already on regardless: Blazor publish defaults to
         PublishTrimmed with TrimMode=partial.

         If this is ever turned on, turn it on in QrLinkPdf.Wasm.SmokeTest as
         well, or ./smoke-wasm.sh stops testing the configuration that ships. -->
    <RunAOTCompilation>false</RunAOTCompilation>

    <!-- Deliberately not invariant: InvariantGlobalization implies
         PredefinedCulturesOnly, and iText has culture-sensitive code paths.
         Download size isn't a concern here, so keep ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.fs" />
    <Compile Include="Startup.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bolero" Version="0.25.63" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />

    <!-- Keep managed and native Skia on the same version. ZXing.Net.Bindings.SkiaSharp
         forces managed SkiaSharp to 4.151.1, while PDFtoImage's browser dependency
         group would otherwise bring the 4.150.1 native archive - and SkiaSharp's
         managed/native contract is a raw C ABI with no version negotiation. -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- itext7 / PDFtoImage / ZXing come through here. They deliberately aren't
         repeated above: NuGet resolves the transitive graph against this
         project's TFM, so they pick their browser assets on their own. -->
    <ProjectReference Include="../QrLinkPdf.Core/QrLinkPdf.Core.fsproj" />
  </ItemGroup>

</Project>
