<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QrLinkPdf.Core</AssemblyName>
    <RootNamespace>QrLinkPdf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Scanner.fs" />
    <Compile Include="Geometry.fs" />
    <Compile Include="ExistingLinks.fs" />
    <Compile Include="TextLinker.fs" />
    <Compile Include="PdfQrLinker.fs" />
    <Compile Include="TesseractWords.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext7" Version="9.7.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.24" />

    <!-- Keep managed SkiaSharp and every native asset on one version.
         ZXing.Net.Bindings.SkiaSharp requires SkiaSharp >= 4.151.1 while
         PDFtoImage asks for 4.150.1, so the managed library resolves to
         4.151.1 and the macOS/Windows natives follow it. The Linux native is
         pinned directly by PDFtoImage, though, so without this it stays at
         4.150.1 and SkiaSharp's startup version check throws
         "native libSkiaSharp (150.0) is incompatible ... range [151.0, 152.0)".
         That only shows up on Linux, so it passes locally on a Mac and fails
         in CI.

         Bumped to 4.152.0 (from 4.151.1) because Tesseract.CrossPlatform.SkiaSharp
         (see Ocr.fs) requires SkiaSharp >= 4.152.0 - same reasoning, just a
         higher floor now. -->
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />

    <!-- Declared here, not separately in QrLinkPdf.fsproj/QrLinkPdf.Wasm.fsproj:
         both hosts need the exact same versions anyway (see TesseractWords.fs's
         own comment), and this project's other native dependencies
         (itext7/PDFtoImage/ZXing above) already work this way - each host
         picks up the right native asset transitively based on its own
         TargetFramework/RuntimeIdentifier, the same mechanism
         Tesseract.Native.browser-wasm's buildTransitive target relies on.

         PREVIEW 5.5.2.200-preview.52a768c, not yet on nuget.org - restored
         from the local feed in ../NuGet.Config (gitignored; see its own
         comment), from
         https://github.com/jbtule/tesseract-nuget-platforms/actions/runs/34458024671. -->
    <PackageReference Include="Tesseract.CrossPlatform" Version="5.5.2.200-preview.52a768c" />
    <PackageReference Include="Tesseract.CrossPlatform.SkiaSharp" Version="5.5.2.200-preview.52a768c" />
    <!-- Desktop native runtimes (win-x64/win-arm64/linux-x64/linux-arm64/
         osx-arm64) - a no-op for a browser-wasm consumer, since none of its
         runtime.<rid> packages have a matching RID there. -->
    <PackageReference Include="Tesseract.Native" Version="5.5.2.200-preview.52a768c" />
    <!-- Statically-linked browser-wasm native build - a no-op everywhere
         else, since its buildTransitive target is conditioned on
         $(RuntimeIdentifier) == 'browser-wasm'. -->
    <PackageReference Include="Tesseract.Native.browser-wasm" Version="5.5.2.200-preview.52a768c" />
  </ItemGroup>

</Project>
