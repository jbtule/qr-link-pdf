<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QrLinkPdf.Core</AssemblyName>
    <RootNamespace>QrLinkPdf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Scanner.fs" />
    <Compile Include="PdfQrLinker.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext7" Version="9.7.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.24" />
  </ItemGroup>

</Project>
