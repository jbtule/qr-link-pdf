{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run QrLinkPdf",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/QrLinkPdf.dll",
            "args": [
                "${input:inputPdf}",
                "${input:outputPdf}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ],
    "inputs": [
        {
            "id": "inputPdf",
            "type": "promptString",
            "description": "Path to the input PDF"
        },
        {
            "id": "outputPdf",
            "type": "promptString",
            "description": "Path for the output PDF"
        }
    ]
}
