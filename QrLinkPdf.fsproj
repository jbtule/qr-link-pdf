<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ocr.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="QrLinkPdf.Core/QrLinkPdf.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drop-in replacement for the stock Tesseract package (same
         namespace/types), from https://github.com/jbtule/tesseract-nuget-platforms.
         Its patched loader checks the flat output directory and a
         runtimes/<rid>/native/ fallback automatically, with generic
         (unversioned) library names - so no CustomSearchPath setup, no
         renamed-file copy target, on any of win-x64/win-arm64/linux-x64/
         linux-arm64/osx-arm64. Verified with real OCR end-to-end via plain
         `dotnet run`, no -r/<RuntimeIdentifier> needed.

         This one reference is enough as of 5.5.2.2 - Tesseract.Native (which
         it depends on) pulls in all five runtime packages and NuGet's RID
         graph picks the right one. Earlier 5.5.2/5.5.2.1 needed each
         Tesseract.Native.runtime.<rid> package referenced directly instead,
         because going through the meta-package silently dropped the native
         files (resolved to NuGet's "no content" placeholder) - fixed
         upstream in 5.5.2.2, confirmed here before switching. -->
    <PackageReference Include="Tesseract.CrossPlatform" Version="5.5.2.2" />
  </ItemGroup>

</Project>
