<?xml version="1.0" encoding="utf-8"?>
<!-- Standing escape hatch for testing an unpublished preview build from
     jbtule/tesseract-nuget-platforms (or any other package) before it's on
     nuget.org - normally inert: .local-nuget-feed/ doesn't exist by
     default, and a nonexistent local folder source is silently skipped by
     `dotnet restore`, confirmed empirically (no warning, no error).

     To use: `gh run download <run-id> -R jbtule/tesseract-nuget-platforms
     -n nuget-packages -D .local-nuget-feed`, then bump the package versions
     in QrLinkPdf.Core.fsproj to match. .local-nuget-feed/ itself is
     gitignored (the .nupkgs are large and workflow-run-specific) - this
     file is the only part meant to be committed. Clear
     .local-nuget-feed/ back out once you're done (or just leave it; it's
     gitignored either way). -->
<configuration>
  <packageSources>
    <add key="local-tesseract-preview" value=".local-nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
