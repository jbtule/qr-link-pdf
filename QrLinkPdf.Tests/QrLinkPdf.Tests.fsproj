<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Runnable directly - Program.fs hand-writes the same one-line
         AddAnyUnitTestFramework() setup AnyUnit.TestingPlatform's own
         EnableAnyUnitRunner property would otherwise codegen as a C#
         file (which an .fsproj can't compile) - see Program.fs's own
         comment. No separate satellite/.Mtp project needed.

         For `dotnet test` itself to actually invoke this MTP app (rather
         than silently no-op'ing through the classic VSTest path, which
         has nothing to discover here) needs the repo-root global.json's
         own `"test": {"runner": "Microsoft.Testing.Platform"}` - that's
         the real switch; confirmed empirically that no combination of
         MSBuild properties/PackageReferences on this project alone
         (IsTestingPlatformApplication, a direct Microsoft.Testing.Platform
         reference, even Microsoft.Testing.Platform.MSBuild) changes
         `dotnet test`'s own routing decision without it. -->
    <OutputType>Exe</OutputType>

    <!-- OcrTests.fs constructs a real TesseractEngine, which needs
         Tesseract.Native's flat native asset next to the test assembly -
         that only gets copied for a RID-targeted build/restore (see
         Tesseract.CrossPlatform's own README: "a bare dotnet run/build
         with no RID context anywhere ... won't have any native asset to
         find"). A plain `dotnet test` has no such context, so pin it to
         whatever RID the current machine's SDK actually is - confirmed the
         hard way: this passed locally (macOS apparently resolves an
         implicit RID for a single-match platform) but failed in CI on
         Linux with DllNotFoundException before this was added. -->
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="TestPdfs.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="DegradedTests.fs" />
    <Compile Include="OcrTests.fs" />
    <Compile Include="ImageToPdfTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../QrLinkPdf.Core/QrLinkPdf.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OcrTests.fs's own fixture, copied in from the repo-root tessdata/
         used for local dev (README's OCR setup step; gitignored, same as
         the CLI's own convention) if present. CI fetches it fresh instead
         (see deploy.yml) since nothing is checked in here. -->
    <None
      Include="../tessdata/eng.traineddata"
      CopyToOutputDirectory="PreserveNewest"
      Link="tessdata/eng.traineddata"
      Condition="Exists('../tessdata/eng.traineddata')" />
  </ItemGroup>

  <ItemGroup>
    <!-- AnyUnit (prerelease, via .local-nuget-feed - see NuGet.Config's
         own comment for the pattern this reuses). Every test in this
         project is now AnyUnit.Style.FSharp's `test { }` - the last
         [<Theory>]/[<InlineData>] holdouts converted once
         AnyUnit.Style.FSharp gained IRowInlineParameter-based
         parametrized-test discovery, so xunit/xunit.runner.visualstudio
         are gone entirely. AnyUnit.Style.Xunit stays for its
         Assert.Equal(...)/InlineData IAssert extension vocabulary -
         AnyUnit.Style.FSharp only provides test structure/discovery, not
         assertion vocabulary, so any style package's assertions/row
         attributes can be mixed in. -->
    <PackageReference Include="AnyUnit" Version="1.0.0-alpha.0.103" />
    <PackageReference Include="AnyUnit.Style.FSharp" Version="1.0.0-alpha.0.103" />
    <PackageReference Include="AnyUnit.Style.Xunit" Version="1.0.0-alpha.0.103" />
    <!-- Program.fs's own MTP entry point (see its comment). -->
    <PackageReference Include="AnyUnit.TestingPlatform" Version="1.0.0-alpha.0.103" />
  </ItemGroup>

</Project>